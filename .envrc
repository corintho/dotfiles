export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

# The use_devenv function supports passing flags to the devenv command
# For example: use devenv --impure --option services.postgres.enable:bool true
use devenv

# `devenv up -d` starts a native-process-manager daemon that supervises
# omp-model-sync forever -- it's never meant to exit. `-d`/`--detach` only
# makes the *devenv up* CLI invocation itself return quickly; it does not
# guarantee the daemon it spawns is fully detached from this script's file
# descriptors. If the daemon inherits any fd this shell doesn't explicitly
# close -- not just stdout/stderr, but also the extra fds (3, 4) direnv
# itself keeps open across the .envrc run -- direnv's export capture will
# block forever waiting for every copy of those fds to close, which never
# happens while the daemon is alive. That hangs `direnv export` (and thus
# every new shell) on activation, well after this script has finished.
#
# Double-fork and explicitly redirect/close every inherited fd so the
# daemon can never hold a shell hostage, regardless of what `devenv up -d`
# does internally. See: https://github.com/direnv/direnv/wiki/Daemonize
(
  (
    exec 0</dev/null
    exec 1>/dev/null
    exec 2>&1
    exec 3>&-
    exec 4>&-
    exec devenv up -d omp-model-sync
  ) &
) 2>/dev/null || true
